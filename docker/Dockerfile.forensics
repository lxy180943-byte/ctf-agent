FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.title="ctf-agent forensics"
LABEL org.opencontainers.image.description="Forensics and stego triage tools for authorized CTF artifacts."

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      python3 \
      python3-pip \
      binwalk \
      libimage-exiftool-perl \
      foremost \
      pngcheck \
      steghide \
      ruby \
      ruby-dev \
      build-essential \
      bash \
      coreutils \
    && mkdir -p /opt/ctf-agent \
    && printf '%s\n' \
      'zsteg is Ruby-based and can be installed in a derived image when needed:' \
      '  gem install zsteg' \
      'It is documented instead of forced here to keep the base forensics image more predictable.' \
      > /opt/ctf-agent/README.zsteg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["bash"]
