FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.title="ctf-agent web"
LABEL org.opencontainers.image.description="Web challenge tooling for authorized CTF services."

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      python3 \
      python3-requests \
      python3-httpx \
      curl \
      wget \
      nmap \
      ffuf \
      sqlmap \
      jq \
      bash \
      coreutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["bash"]
